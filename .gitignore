# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# launch.json contains the Gemini API key via --dart-define; never commit it.
.vscode/launch.json

# Firebase / GCP service account keys — store in Secret Manager, never commit
*firebase-adminsdk*.json
*service-account*.json
*-sa-key*.json

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Map tokens (contains API keys)
lib/core/constants/map_tokens.dart

# Environment / secrets
.env
.env.local
.env.*.local

# Supabase local state
supabase/.temp/
supabase/.branches/

# Android local config (contains SDK paths and API keys)
android/local.properties

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

node_modules/
package-lock.json

# Agent / IDE tooling artifacts (local skill caches, MCP config, etc.)
# These are per-developer tooling state, not project source.
.agents/
.claude/
.junie/
.trae/
.windsurf/
.zai/
.zcode/
.mcp.json

# Temp / debug artifacts
NUL
%TEMP*
all_diffs.txt
graphify-out/
bugreport-*.zip
Usersdawas*

# Screenshots / reports (regenerate locally)
screenShots/
reports/

